# override-values.yaml — copy to override-values.yaml, fill in the
# placeholders below, and install with:
#   helm install mdcluster ./mdcluster -f override-values.yaml
#
# Do not commit the filled-in copy — it contains real credentials.

# --- Images -----------------------------------------------------------------
DOCKER_REPO: 'opswat/metadefendercluster-debian'  # <DOCKER_REPO>:<service>-<MDCLS_VERSION>
MDCLS_VERSION: '2.10.0'
imagePullPolicy: IfNotPresent
# imagePullSecrets:
#   - name: regcred

# --- Workers: replica count per instance type ------------------------------
workers:
  ometascan:
    replicas: 1
  api-gateway:
    replicas: 1
  callback-service:
    replicas: 1
  download-service:
    replicas: 1

secrets:
  # --- Generated by the chart when left unset -- uncomment only to pin your own.
  # Read a generated value back with:
  #   kubectl -n mdcluster get secret mdcluster-secrets \
  #     -o jsonpath='{.data.ADMIN_APIKEY}' | base64 -d
  #
  # CONTROL_CENTER_ENCRYPTION_KEY: '<32-character-key>'  # must be EXACTLY 32 characters
  # ADMIN_APIKEY: '<36-hex-char-key>'
  #
  # Connection keys: 4-64 alphanumeric chars, one shared value is fine.
  # IDENTITY_CONNECTION_KEY: '<key>'
  # FILE_STORAGE_CONNECTION_KEY: '<key>'
  # WORKER_CONNECTION_KEY: '<key>'

  # --- Bootstrap administrator account ---
  ADMIN_USER: '<admin-account>'
  ADMIN_PASSWORD: '<admin-password>'
  ADMIN_EMAIL: '<admin-email>'

  # --- License ---
  # The source of truth for the cluster's licensing. Control Center reconciles
  # its license list to exactly the resolved value every time it starts, so
  # GIVING THIS KEY A VALUE IS AN INSTRUCTION -- and leaving it out is not the
  # same as setting it to '':
  #
  #   not specified / null  -> keep whatever LICENSE_KEY is already in the live
  #                            mdcluster-secrets Secret. This is the safe
  #                            default, and it is what lets a key injected by
  #                            External Secrets Operator / Sealed Secrets /
  #                            Vault Agent / `kubectl create secret` survive an
  #                            upgrade.
  #   ''                    -> REMOVE ALL LICENSING. Every license is
  #                            deactivated and deleted, and scans stop working.
  #   '<license-key>'       -> that key is applied and becomes the only license.
  #                            Deployed MD Core instances are activated with it
  #                            automatically; changing it later makes `helm
  #                            upgrade` roll the Control Center pod and migrate
  #                            the fleet (the workers do NOT restart). An
  #                            invalid or unreachable key is only a warning and
  #                            leaves the previous license running.
  #
  # A license added by hand in the Control Center UI is deleted on the next
  # Control Center restart. Manage licenses here, not in the UI.
  #
  # The "keep what is in the Secret" fallback needs cluster access at render
  # time: if you render client-side (`helm template`, `--dry-run`, Argo CD's
  # default) it resolves to empty -- which REMOVES ALL LICENSES. See "Changing
  # the license key" in README.md.
  #
  # Left commented out on purpose: uncomment it only when you actually want to
  # set or clear the cluster's license.
  # LICENSE_KEY: '<license-key>'

# --- Persistence (recommended: see "Production configuration" in README.md) ---
postgres:
  enabled: true
  persistence:
    enabled: true
    size: 100Gi

file-storage:
  replicas: 1
  persistence:
    enabled: true
    size: 100Gi
